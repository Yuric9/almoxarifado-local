{
  "name": "almoxarifado-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "next build",
    "desktop:package": "npm run build && electron-builder"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "electron": "^32.1.2",
    "concurrently": "^9.0.1",
    "wait-on": "^8.0.1",
    "electron-builder": "^25.0.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.yuric9.almoxarifado",
    "productName": "Almoxarifado Local",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Almoxarifado-Local-Portable.exe"
    }
  }
}
